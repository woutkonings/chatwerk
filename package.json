{
  "name": "chatwerk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import ./server/strudel-node.mjs server/index.ts & vite; wait",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import ./server/strudel-node.mjs server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "allowlist:check": "tsx --import ./server/strudel-node.mjs scripts/check-allowlist.ts",
    "bakeoff": "tsx --env-file-if-exists=.env --import ./server/strudel-node.mjs scripts/bakeoff.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "2.1.1",
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/reference": "^1.2.2",
    "@strudel/tonal": "^1.2.6",
    "acorn": "^8.19.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.9",
    "ws": "8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@strudel/web": "1.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.1",
    "vitest": "^5.0.3"
  }
}
